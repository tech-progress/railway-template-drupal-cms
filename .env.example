# Local Compose verification only (scripts/local-check.sh generates its own).
# Railway generates every secret itself.
# At least 16 printable characters; letters and digits are safest.
POSTGRES_PASSWORD=changemechangemechangeme1
# At least 32 printable characters.
DRUPAL_HASH_SALT=changemechangemechangemechangemechangeme2
# 16-128 printable ASCII characters without spaces.
DRUPAL_ADMIN_PASSWORD=changemechangemechangeme3
DRUPAL_ADMIN_EMAIL=admin@example.com
